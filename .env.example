# Supabase project settings used by the document chunk repository.
# Supabase key with INSERT permission on document_chunks.
# For server-side use, a service-role key is recommended.
SUPABASE_URL=
SUPABASE_KEY=

# Google Gemini API for embeddings
# GEMINI_API_KEY: Google AI Studio or Vertex AI API key
GEMINI_API_KEY=

# OpenRouter for LLM generation
# OPENROUTER_API_KEY: OpenRouter API key
# OPENROUTER_MODEL: Model identifier (e.g., openai/gpt-4o-mini, anthropic/claude-3.5-sonnet)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Embedding configuration
# EMBEDDING_MODEL: Embedding model name (default: models/gemini-embedding-001)
# EMBEDDING_BATCH_SIZE: Batch size for embedding generation (default: 1)
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_BATCH_SIZE=5

# Gemini Embedding 1 quota.
# Current observed hard limit: 30,000 tokens/minute.
EMBEDDING_TPM_LIMIT=30000

# Application target kept below the hard quota for safety.
EMBEDDING_TPM_TARGET=24000

# Maximum number of retries for Gemini 429 responses.
EMBEDDING_MAX_RETRIES=5

# Initial exponential-backoff delay for 429 responses.
EMBEDDING_BASE_BACKOFF_SECONDS=2
