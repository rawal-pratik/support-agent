# Supabase project settings used by the document chunk repository.
# SUPABASE_URL: Supabase project URL (e.g., https://xyz.supabase.co)
# SUPABASE_KEY: Supabase service role key (NOT the anon key)
SUPABASE_URL=
SUPABASE_KEY=

# Google Gemini API for embeddings
# GEMINI_API_KEY: Google AI Studio or Vertex AI API key
GEMINI_API_KEY=

# OpenRouter for LLM generation
# OPENROUTER_API_KEY: OpenRouter API key
# OPENROUTER_MODEL: Model identifier (e.g., openai/gpt-4o-mini, anthropic/claude-3.5-sonnet)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Embedding configuration
# EMBEDDING_MODEL: Embedding model name (default: models/gemini-embedding-001)
# EMBEDDING_BATCH_SIZE: Batch size for embedding generation (default: 1)
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_BATCH_SIZE=1
